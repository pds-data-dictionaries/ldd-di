  <xs:complexType name="Temperature_Measurement">
    <xs:annotation>
      <xs:documentation> The di:Temperature_Measurement class reports a
        single temperature reading by a specific sensor.
        </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sensor_location" type="di:sensor_location" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="temperature" type="di:temperature" minOccurs="1" maxOccurs="1"> </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Voltage_Measurement">
    <xs:annotation>
      <xs:documentation> The di:Voltage_Measurement class reports a
        single voltage reading by a specific sensor. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="sensor_location" type="di:sensor_location" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="voltage" type="di:voltage" minOccurs="1" maxOccurs="1"> </xs:element>
    </xs:sequence>
