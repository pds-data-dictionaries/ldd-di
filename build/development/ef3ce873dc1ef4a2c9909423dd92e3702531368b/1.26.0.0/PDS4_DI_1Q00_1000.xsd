        image. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="pds:ASCII_Real">
     <xs:minInclusive value="-1.7976931348623157e308"/>
     <xs:maxInclusive value="1.7976931348623157e308"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="scaled_minimum">
    <xs:annotation>
      <xs:documentation> The di:scaled_minimum indicates the smallest
        value occurring in the image itself after the application of any
