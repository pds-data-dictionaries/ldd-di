    <xs:restriction base="pds:ASCII_Real">
     <xs:minInclusive value="-1.7976931348623157e308"/>
     <xs:maxInclusive value="1.7976931348623157e308"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="stored_standard_deviation">
    <xs:annotation>
      <xs:documentation> The di:stored_standard_deviation provides the
