    </xs:annotation>
    <xs:restriction base="pds:ASCII_Short_String_Collapsed">
     <xs:minLength value="1"/>
     <xs:maxLength value="255"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="saturated_pixel_count">
    <xs:annotation>
      <xs:documentation> The di:saturated_pixel_count provides a count
