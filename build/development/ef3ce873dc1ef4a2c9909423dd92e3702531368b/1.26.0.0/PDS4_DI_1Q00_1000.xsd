        container class for the subclasses comprising the namespace
        shared by the Deep Impact and EPOXI missions. </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="mission_phase_name" type="di:mission_phase_name" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="spacecraft_clock_start" type="di:spacecraft_clock_start" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="spacecraft_clock_mid" type="di:spacecraft_clock_mid" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="spacecraft_clock_stop" type="di:spacecraft_clock_stop" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="Observation_Parameters" type="di:Observation_Parameters" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="Instrument_Parameters" type="di:Instrument_Parameters" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="Image_Statistics" type="di:Image_Statistics" minOccurs="1" maxOccurs="1"> </xs:element>
    </xs:sequence>
  </xs:complexType>

