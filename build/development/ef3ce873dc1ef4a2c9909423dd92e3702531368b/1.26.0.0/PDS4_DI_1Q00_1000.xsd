    <xs:restriction base="pds:ASCII_Real">
     <xs:minInclusive value="-1.7976931348623157e308"/>
     <xs:maxInclusive value="1.7976931348623157e308"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="stored_minimum">
    <xs:annotation>
      <xs:documentation> The di:stored_minimum indicates the smallest
        value occurring in the stored pixels of the image itself. In the
        final DI/EPOXI pipeline, pixels in the overclock areas bordering
        the VIS CCDs or pixels in the reference rows and columns
        bordering the HRI IR spectrometer are included in the image
