    </xs:annotation>
    <xs:restriction base="pds:ASCII_NonNegative_Integer">
    	<xs:pattern value='[0-9]+'/>
     <xs:minInclusive value="0"/>
     <xs:maxInclusive value="18446744073709551615"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="scaled_maximum">
    <xs:annotation>
      <xs:documentation> The di:scaled_maximum indicates the largest
        value occurring within the image itself after the application of
        any scaling factor and offset. In the final DI/EPOXI pipelines,
        pixels in the overclock areas bordering the VIS CCDs or pixels
        in the reference rows and columns bordering the HRI IR
        spectrometer are included in the image object but are excluded
        from the value. Values are stated as real numbers regardless of
        the data type of the elements of the associated image.
        </xs:documentation>
    </xs:annotation>
    <xs:restriction base="pds:ASCII_Real">
     <xs:minInclusive value="-1.7976931348623157e308"/>
     <xs:maxInclusive value="1.7976931348623157e308"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="scaled_median">
    <xs:annotation>
      <xs:documentation> The di:scaled_median provides the median value
        (middle value) occurring in the image itself after the
        application of any scaling factor and offset. In the final
        DI/EPOXI pipeline, pixels in the overclock areas bordering the
        VIS CCDs or pixels in the reference rows and columns bordering
        the HRI IR spectrometer are included in the image object but are
        excluded from the value. Values are stated as real numbers
