      <xs:element name="product_type" type="di:product_type" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="spacecraft_processor_id" type="di:spacecraft_processor_id" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="sdc_pipeline_file_name" type="di:sdc_pipeline_file_name" minOccurs="1" maxOccurs="1"> </xs:element>
      <xs:element name="Imaging" type="di:Imaging" minOccurs="0" maxOccurs="1"> </xs:element>
      <xs:element name="Geometry" type="di:Geometry" minOccurs="0" maxOccurs="1"> </xs:element>
